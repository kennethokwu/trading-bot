# Dashboard port
PORT=5000

# Run with synthetic price feeds (no exchange connections). Good for demos.
MOCK_FEEDS=false

# Taker fees as fractions (0.001 = 0.10%). Set your real fee tier.
FEE_BINANCE=0.001
FEE_COINBASE=0.006
FEE_KRAKEN=0.004

# Per-leg haircut for slippage / USD-USDT basis (0.0002 = 2 bps)
SLIPPAGE_BUFFER=0.0002

# Paper-trade an opportunity when net edge exceeds this (0.0005 = 5 bps)
MIN_NET_EDGE_TRADE=0.0005

# Simulated size per paper trade, in USD
TRADE_NOTIONAL=1000

# Ignore the same opportunity key for this long after trading it (ms)
TRADE_COOLDOWN_MS=5000

# Ignore quotes older than this (ms)
MAX_QUOTE_AGE_MS=10000

# --- Funding-rate carry monitor ---
# Poll interval for perp funding rates (ms)
FUNDING_POLL_MS=60000
# Simulated carry position size (USD)
CARRY_NOTIONAL=10000
# Round-trip entry+exit cost charged up front (0.002 = 0.20%)
CARRY_ENTRY_COST=0.002
# Enter when best positive funding annualizes above this (0.08 = 8% APR)
CARRY_MIN_APR=0.08
# Exit when the position's funding annualizes below this
CARRY_EXIT_APR=0
