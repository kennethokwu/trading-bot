# Dashboard port
PORT=5000

# Run with synthetic price feeds (no exchange connections). Good for demos.
MOCK_FEEDS=false

# Taker fees as fractions (0.001 = 0.10%). Set your real fee tier.
FEE_BINANCE=0.001
FEE_COINBASE=0.006
FEE_KRAKEN=0.004

# Per-leg haircut for slippage / USD-USDT basis (0.0002 = 2 bps)
SLIPPAGE_BUFFER=0.0002

# Paper-trade an opportunity when net edge exceeds this (0.0005 = 5 bps)
MIN_NET_EDGE_TRADE=0.0005

# Simulated size per paper trade, in USD
TRADE_NOTIONAL=1000

# Ignore the same opportunity key for this long after trading it (ms)
TRADE_COOLDOWN_MS=5000

# Ignore quotes older than this (ms)
MAX_QUOTE_AGE_MS=10000
